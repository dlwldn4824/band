# =============================================================================
# 로컬 개발용 환경 변수 템플릿
# 사용법: 이 파일을 복사해 `.env` 로 저장한 뒤 값을 채우세요.
#   cp .env.example .env
#
# ⚠️ `.env` 는 git에 올라가지 않습니다 (.gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase (필수) — Vite 빌드·배포 시 반드시 필요
# Firebase 콘솔 → 프로젝트 설정(톱니) → 일반 → 내 앱 → SDK 설정 및 구성
# 본인 프로젝트(Band-Info 등)의 값으로 채우세요. 예전 band-info-58b2d 와 다를 수 있음.
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# 선택 — 없으면 앱 기본값 또는 manage에서 URL 직접 입력
# -----------------------------------------------------------------------------
# Google Sheets 연동 (manage > 게스트 시트 동기화)
VITE_GOOGLE_SHEETS_WEB_APP_URL=

# 채팅 페이지 사진첩 링크
VITE_GOOGLE_DRIVE_LINK=

# -----------------------------------------------------------------------------
# 로컬 전용 (node server — `npm run dev:server`)
# Vercel 프론트 배포에는 넣지 않아도 됩니다.
# -----------------------------------------------------------------------------
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

# -----------------------------------------------------------------------------
# 서버 전용 (VITE_ 접두사 금지 — 클라이언트 번들에 노출됨)
# Vercel: 프로젝트 Settings → Environment Variables 에 설정
# 로컬: `.env` 에 설정 후 `npm run dev:server` 또는 `npm run dev:all`
# ⚠️ 비밀번호는 git에 올리지 마세요. Vercel Environment Variables에 설정하세요.
# -----------------------------------------------------------------------------
ADMIN_LOGIN_CODE=
ADMIN_ACTION_PASSWORD=
# Firebase Admin SDK (서버 API 전용) — JSON 전체 또는 base64 인코딩
FIREBASE_SERVICE_ACCOUNT=
# 선택: 관리자 API 토큰 서명용 (미설정 시 ADMIN_ACTION_PASSWORD 사용)
ADMIN_TOKEN_SECRET=
