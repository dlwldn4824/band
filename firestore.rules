rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 공개 데이터 - 누구나 읽기 가능
    match /current/{document=**} {
      allow read, write: if true;
    }

    match /entries/{document=**} {
      allow read, write: if true;
    }

    match /chat/{document=**} {
      allow read, write: if true;
    }

    match /onlineUsers/{document=**} {
      allow read, write: if true;
    }

    match /guests/{document=**} {
      allow read, write: if true;
    }

    // V2: 새 guests 컬렉션 (기존 데이터와 분리)
    match /guests_v2/{document=**} {
      allow read, write: if true;
    }

    match /performanceData/{document=**} {
      allow read, write: if true;
    }

    match /messages/{document=**} {
      allow read, write: if true;
    }

    match /userProfiles/{document=**} {
      allow read, write: if true;
    }

    match /rpsTournament/{document=**} {
      allow read, write: if true;
    }

    match /roulette/{document=**} {
      allow read, write: if true;
    }

    match /entryDraw/{document=**} {
      allow read, write: if true;
    }

    // 예약 정보 컬렉션 추가
    match /bookingInfo/{document=**} {
      allow read, write: if true;
    }

    // 예매 신청 컬렉션 추가
    match /bookings/{document=**} {
      allow read, write: if true;
    }

    // 응원 메시지 컬렉션 추가
    match /songComments/{document=**} {
      allow read, write: if true;
    }

    // 로그인 토큰 컬렉션 추가
    match /loginTokens/{document=**} {
      allow read, write: if true;
    }

    // 주류 구매 주문 컬렉션 추가
    match /drinkOrders/{document=**} {
      allow read, write: if true;
    }

    // 분석 이벤트 (클라이언트 append-only)
    match /analytics_events/{eventId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

  }
}

