rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 공개 읽기 허용 (쓰기는 서버 Admin SDK만)
    match /current/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /entries/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /performanceData/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /bookingInfo/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // 게스트·예매 — 클라이언트 접근 전면 차단 (서버 API 전용)
    match /guests/{document=**} {
      allow read, write: if false;
    }

    match /guests_v2/{document=**} {
      allow read, write: if false;
    }

    match /bookings/{document=**} {
      allow read, write: if false;
    }

    // 실시간 UX용 read-only (쓰기는 서버 API)
    match /chat/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /onlineUsers/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /songComments/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /messages/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /roulette/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /entryDraw/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // 민감 데이터 — read/write 모두 차단 (서버 API 전용)
    match /userProfiles/{document=**} {
      allow read, write: if false;
    }

    match /drinkOrders/{document=**} {
      allow read, write: if false;
    }

    match /analytics_events/{document=**} {
      allow read, write: if false;
    }

    match /rpsTournament/{document=**} {
      allow read, write: if false;
    }

    match /rateLimits/{document=**} {
      allow read, write: if false;
    }

    match /loginTokens/{document=**} {
      allow read, write: if false;
    }

  }
}
